#!/bin/sh
# Data-boundary check on what is about to be pushed: the files at the end of each pushed range and every line added by its commits (docs/data-boundary.md).
command -v node >/dev/null 2>&1 || { echo "boundary: node is required for the push check" >&2; exit 1; }
top="$(git rev-parse --show-toplevel)"; zero=0000000000000000000000000000000000000000; rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue                                   # a deletion pushes no content
  if [ "$remote_sha" = "$zero" ]; then base="$(git merge-base "$local_sha" origin/main 2>/dev/null || git rev-list --max-parents=0 "$local_sha" | tail -1)"; else base="$remote_sha"; fi
  node "$top/tools/boundary-check.mjs" --range "$base..$local_sha" || rc=1
done
exit $rc
